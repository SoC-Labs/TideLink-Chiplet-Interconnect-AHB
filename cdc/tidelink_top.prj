##-----------------------------------------------------------------------------
## SoCLabs TideLink — SpyGlass CDC Project File
##
## Reads RTL from the standard flist, applies CDC constraints, and runs
## the cdc_verify goal for structural CDC analysis.
##
## Usage (via Makefile):
##   make -C cdc cdc              # default: tidelink_top
##   make -C cdc cdc MODULE=...   # override module
##
## Contributors
##
## David Mapstone (d.a.mapstone@soton.ac.uk)
##
## Copyright 2026, SoC Labs (www.soclabs.org)
##-----------------------------------------------------------------------------

## ── Design read ─────────────────────────────────────────────────────────────

# SystemVerilog mode
set_option enableSV09 yes
set_option language_mode mixed
set_option designread_enable_synthesis no
set_option mthresh 50000

# Read source files from flist (environment variables expanded by Makefile)
read_file -type sourcelist $::env(FLIST)

# ── Elaboration ──────────────────────────────────────────────────────────────

set_option top $::env(SG_TOP)

# ── Constraints ──────────────────────────────────────────────────────────────

read_file -type sgdc $::env(SGDC)

# Port-level constraints for black-boxed third-party IP
read_file -type sgdc $::env(TIDELINK_HOME)/cdc/axi_chiplet_controller.sgdc
read_file -type sgdc $::env(TIDELINK_HOME)/cdc/xhb500.sgdc

# ── Waivers ──────────────────────────────────────────────────────────────────

read_file -type waiver $::env(SWL)

# ── Black-box pre-verified third-party IP ────────────────────────────────────
# Prevents SpyGlass from tracing through these modules, so CDC analysis
# only sees their port-level constraints (defined via abstract_port in SGDC).
# Internal CDC is pre-verified by the IP vendor.

set_option stop_module {axi_chiplet_controller xhb500_axi_to_ahb_bridge_chiplet_mst xhb500_ahb_to_axi_bridge_chiplet_slv}

# ── Goal setup ───────────────────────────────────────────────────────────────
# Goal is specified via -goals on the command line (required for -batch mode).
# current_goal / run_goal are not used in -batch -project -goals flow.
