# ----------------------------------------------------------------------------
# DELIBERATELY NOT WAIVED — locally modified, so the vendor justification does
# not apply.  If any of these reports a CDC violation it is a finding about
# SoC Labs logic and must be read, not suppressed.  Adding a `-du` line for
# any name below will fail `gen_tidelink_waivers.py --check`.
#
# Wlink hierarchy (patched copies in src/rtl/local_overrides/):
#   Wlink                            — link top; local PSTATE/obs changes
#   WlinkRxLinkLayer                 — RX LL; training-filler handling
#   WlinkGPIOPHY                     — GPIO PHY wrapper
#   WlinkEccSyndrome                 — ECC syndrome
#   WlinkGenericFCSM                 — FC state machine  (+_1 _2 _3 _4 _6)
#   WlinkGenericFCSM_1
#   WlinkGenericFCSM_2
#   WlinkGenericFCSM_3
#   WlinkGenericFCSM_4
#   WlinkGenericFCSM_6
#   WlinkGenericFCReplayV2_12        — carries the a2l CDC self-latch fix
#   WlinkGenericFCReplayV2_13        — carries the a2l CDC self-latch fix
#   WlinkGenericFCReplayV2_1         — AW/W/B sibling; fix NOT ported. Leaving
#   WlinkGenericFCReplayV2_3           these unwaived is the whole point: the
#   WlinkGenericFCReplayV2_5           blanket pattern hid the difference
#                                      between the fixed and unfixed nodes.
#   WlinkGenericFCReplayAddrSync_18  — replay address sync
#   ShortPacketToWlink               — SP adapter, locally modified
#   TideLinkToWlink                  — TL adapter, locally modified
#   wlink_wlink_ptp_tl_a2l_48x4      — SoC-Labs-AUTHORED a2l replay memory;
#                                      no vendor original exists at all
#
# Wav primitives (patched copies in src/rtl/local_overrides/):
#   WavD2DGpio                       — D2D GPIO PHY datapath
#   WavD2DGpioRx                     — D2D GPIO RX
#   WavD2DGpioTx                     — D2D GPIO TX
#   WavMultibitSync_18               — MODIFIED SYNCHRONISER PRIMITIVE. Its
#                                      unmodified siblings (WavMultibitSync,
#                                      _15, _3) ARE waived above; this one is
#                                      not, and must not be.
# ----------------------------------------------------------------------------

# ============================================================================
# Third-party IP: Chiplet Controller (axi_chiplet_controller)
# ============================================================================
# The chiplet controller is black-boxed via set_option stop_module in the .prj
# file, so SpyGlass does not elaborate its internals. Port-level clock domains
# are declared via abstract_port in the SGDC.
#
# 2026-08-17 — the `-du axi_chiplet_controller` "safety net" REMOVED.
#
# The rationale for that waiver was the same false premise as the Wlink block
# above: "pre-verified internal CDC".  The unit that actually compiles is
# src/rtl/local_overrides/axi_chiplet_controller.sv, which differs from
# deps/axi-chiplet-controller/logical/top/axi_chiplet_controller.sv by ~5.4k
# diff lines and 15 added ports.  It is TideLink-authored integration logic
# wearing a vendor module name.
#
# The waiver was described as inert ("no effect when black-boxed"), and today
# it is — .prj sets stop_module on this unit.  But its stated purpose was to
# take effect the moment stop_module is lifted, and that is precisely the run
# where the modified internals need to be READ, not suppressed.  An inert
# waiver whose only live case is the wrong answer is worse than none.
#
# If a genuinely-vendor sub-unit inside the controller needs waiving after
# stop_module is lifted, waive that sub-unit by name (the generated list
# above already covers the unmodified Wlink hierarchy).
#
#   waive -du "axi_chiplet_controller"   <- deliberately absent; see above

# I2C sideband controllers (Verilog-RTL I2C from Alex Forencich / Xilinx)
#
# `i2c_master` is NOT waived: src/rtl/local_overrides/i2c_master.v is a
# locally patched copy (19 diff lines vs the vendor file).  Which copy gets
# compiled is flist-dependent — flists/tidelink_top.flist reads the VENDOR
# file, flists/tidelink_fpga.flist reads the OVERRIDE — so a name-scoped
# waiver is sound in one flow and unsound in the other.  Leaving it unwaived
# over-reports on the tidelink_top flow, which is the safe direction.
#
#   waive -du "i2c_master"               <- deliberately absent; see above
#
# i2c_master_axil is likewise locally modified (53 diff lines) and likewise
# unwaived; it never had a waiver.
waive -du "i2c_master_wbs"     -comment "Third-party I2C master wrapper — Chisel/Bluespec generated"
waive -du "i2c_slave"          -comment "Third-party I2C slave IP — own CDC not required"
waive -du "i2c_slave_axil_master" -comment "Third-party I2C slave AXIL wrapper"
waive -du "axis_fifo"          -comment "Third-party AXIS FIFO — Xilinx IP"

# Bluespec-generated AXI/APB bridges inside chiplet controller
waive -du "mkAXI4_to_AXI4_Lite_Adapter" -comment "Bluespec AXI4-to-AXILite adapter"
waive -du "mkAPB_Master_Xactor" -comment "Bluespec APB master transactor"
waive -du "FIFO2"              -comment "Bluespec FIFO2 primitive"
waive -du "FIFOL1"             -comment "Bluespec FIFOL1 primitive"
waive -du "SizedFIFO"          -comment "Bluespec SizedFIFO primitive"

# ============================================================================
# Third-party IP: wav_latch_model
# ============================================================================

waive -du "wav_latch_model"    -comment "Wlink latch model — simulation primitive"

# ============================================================================
# Crossings into black-boxed chiplet controller
# ============================================================================
# The chiplet controller is black-boxed (stop_module). Remaining crossings at
# its port boundary are handled by the controller's internal CDC logic:
#   - hresetn/poresetn: synchronised by WavDemetReset inside Wlink
#   - I2C bus lines: truly async, synchronised by I2C IP
#   - pad_rx: PHY receive data, synchronised by Wlink SerDes
#
# These waivers use -msg to match the destination module name in the violation
# message text generated by SpyGlass.

waive -rule Ac_unsync01 -msg "*i2c_sda_i*"             -comment "I2C SDA — async external bus, synchronised inside chiplet controller"
waive -rule Ac_unsync01 -msg "*i2c_scl_i*"             -comment "I2C SCL — async external bus, synchronised inside chiplet controller"
waive -rule Ac_unsync01 -msg "*axi_chiplet_controller/hresetn*"  -comment "Reset CDC — synchronised by WavDemetReset inside Wlink"
waive -rule Ac_unsync01 -msg "*axi_chiplet_controller/poresetn*" -comment "POR CDC — synchronised by WavDemetReset inside Wlink"
waive -rule Ac_unsync02 -msg "*pad_rx*"                 -comment "PHY RX data — async recovered clock, synchronised by Wlink SerDes"

# ============================================================================
# 2026-05-23 — additions from SpyGlass CDC sign-off report
#   docs/reference/SPYGLASS_CDC_SIGNOFF.md §3.2
#
# tidelink_phc_cdc handshake synchronizers — data-hold provable by inspection.
# All paths use the toggle-req/ack handshake pattern. The source-domain
# *_hold_* register is captured before *_req is toggled and is held stable
# (no further write while in_flight=1) until *_ack returns from the
# destination domain. SpyGlass cannot prove this structurally without an
# assertion; it is exercised continuously by cocotb/phc_ahb and uvm/phc.
# ============================================================================

waive -rule Ac_cdc01a       -file "tidelink_phc_cdc.sv" \
      -comment "Toggle/ack handshake — req-flop held stable until ack, by FSM contract"
waive -rule Ac_datahold01a  -file "tidelink_phc_cdc.sv" \
      -comment "Enable-based snapshot — *_hold_* registers stable while *_req asserted, by FSM contract"
waive -rule Reset_sync04    -file "tidelink_phc_cdc.sv" \
      -comment "Independent ack flops share the same async reset by design"

# Cosmetic — DesignWare black-box for PTP servo multiplier
waive -rule ErrorAnalyzeBBox -du "tidelink_mul_iter" \
      -comment "DesignWare multiplier — port-safe vendor blackbox"

# Cosmetic — SGDC reference current_design for blackboxed sub-units
waive -rule SGDC_waive24    -file "waiver.swl" \
      -comment "Pre-existing safety-net waivers for stop_module'd hierarchy"
waive -rule SGDC_waive25    -file "waiver.swl" \
      -comment "Pre-existing safety-net waivers for stop_module'd hierarchy"
waive -rule checkSGDC_01    -file "xhb500.sgdc" \
      -comment "xhb500 current_design auto-migrated — stop_module'd at top"
# 2026-08-17 — checkSGDC_05: global waiver SCOPED to the two sub-block SGDCs.
#
# FIRST, A CORRECTION, because the wrong version of this is written down in
# more than one place in the tree. checkSGDC_05 is NOT the unmatched-
# abstract_port detector. Per the installed rule documentation
# ($SPYGLASS_HOME/htmlhelp/spyglass/checkSGDC_05.htm, SpyGlass 2022.06-SP2):
#
#     "Checks if constraints are valid for non-top environments. [...] If a
#      constraint is not effective in a non-top environment, that constraint
#      is migrated to the top and violation is flagged."
#
# That is exactly what this flow does on purpose: axi_chiplet_controller.sgdc
# and xhb500.sgdc declare constraints under a NON-TOP `current_design`, for
# blocks that are stop_module'd at the top. SpyGlass migrates them, and
# flags each migration. So the original justification here — "abstract_port
# auto-migrated for stop_module'd subblocks" — was ACCURATE, and the waiver
# was suppressing an expected, benign message rather than hiding drift.
#
# The real unmatched-abstract_port detectors are SGDC_abstract_port02
# ("'<port>' not found on/within module '<module>'") and SGDC_abstract_port21.
# Neither is waived anywhere in this file, or anywhere in this tree. They are
# live and must stay live: SGDC_abstract_port02 is FATAL in this flow (exit
# code 7, a run that reports "0 clocks / 0 crossings" and reads like a tool
# fault), and that is a feature — it makes a stale port name impossible to
# ignore. NOTHING in this file may ever waive them.
#
# WHAT IS ACTUALLY BEING FIXED, THEN. The waiver was global and unscoped: it
# silenced checkSGDC_05 for the top-level SGDC too, where a migration message
# would NOT be expected and would be worth reading. Scoping it to the two
# files whose whole purpose is non-top constraint declaration keeps the noise
# suppressed and the signal live.
#
# AND THE HONEST LIMIT. Neither rule — nor any rule — catches the drift that
# actually recurred here. SGDC_abstract_port02/21 fire on a declaration
# pointing at a name that no longer exists. An OMITTED port (apb_ctrl_reg_rf,
# and eleven others) produces no declaration at all, so there is nothing for
# them to check; the port simply gets defaulted. That direction is only
# reachable by comparing the SGDC against the real port list, which is what
# scripts/cdc/sgdc_port_drift.py does — statically, in both directions, with
# no licence. Treat that script as the standing guard, not this rule.
waive -rule checkSGDC_05 -file "axi_chiplet_controller.sgdc" \
      -comment "Non-top current_design by design — stop_module'd block, constraints legitimately migrate to top"
waive -rule checkSGDC_05 -file "xhb500.sgdc" \
      -comment "Non-top current_design by design — stop_module'd block, constraints legitimately migrate to top"
waive -rule Ac_clockperiod01 \
      -comment "Edge-List autocompleted for async clock groups — no functional impact"

# Cosmetic — perf signed-cast on positive literal
waive -rule WRN_1024 -file "tidelink_perf.sv" \
      -comment "signed-cast applied to small positive literal — width-safe by inspection"

# ============================================================================
# 2026-05-28 — tidelink-gpio-phy submodule integration
#
# Four new CDC paths surface inside the top-level tidelink_gpio_phy_apb_regs
# slave (deps/tidelink-gpio-phy/rtl/tidelink_gpio_phy_apb_regs.sv) once the
# axi_chiplet_controller link_rx_clk_o domain is correctly declared in the
# SGDC.  Waiver rationale per docs/SPYGLASS_CDC_RE_RUN_2026_05_28.md §4.
#
#   (1) hclk → link_rx_clk : 24-bit lock_thresh, 2-bit noise_mode (2-FF)
#       Slow-changing quasi-static config — APB writes once at bring-up,
#       value stable for thousands of link_rx_clk cycles.  Per spec §6.1
#       the lane_checker re-reads every cycle and a temporary mixed-bit
#       value during one write is consumed for at most a single
#       sub-threshold dwell-count window.  Gray encoding not applicable.
#
#   (2) hclk → link_rx_clk : 1-bit clear_noise (3-FF toggle handshake)
#       Edge-detect on toggle_sync2 ^ toggle_sync3 produces a one-cycle
#       pulse in link_rx_clk.  Single-bit toggle is gray-encoded by
#       construction; data-hold is enforced by the self-clearing
#       clear_noise_apb one-shot in the source domain (line 102).
#
#   (3) link_rx_clk → hclk : per-lane observability (~272 bits, 2-FF)
#       Read-only diagnostic counters; per spec §6.1 transient mid-update
#       values are acceptable for SW polling.  No functional control path.
#
#   (4) Reset crossing : role_locked_o (app_clk) resets the link_rx_clk
#       synchronizer flops.  Per INTEGRATION_GUIDE §5.2 role_locked is
#       a quasi-static enable — once asserted it remains stable for the
#       entire functional lifetime of the link; deassertion only occurs
#       during link-loss tear-down which intentionally resets all RX-side
#       state.
# ============================================================================

waive -rule Ac_cdc01a -file "tidelink_gpio_phy_apb_regs.sv" \
      -comment "2-FF/3-FF sync — quasi-static thresholds / mode / self-clearing toggle, per spec §6.1"
waive -rule Ac_conv04 -file "tidelink_gpio_phy_apb_regs.sv" \
      -comment "Multi-bit observability + quasi-static config — gray encoding inapplicable, per spec §6.1"
waive -rule Reset_sync02 -file "tidelink_gpio_phy_apb_regs.sv" \
      -comment "role_locked_o reset is quasi-static (INTEGRATION_GUIDE §5.2) — stable for link lifetime"
waive -rule Reset_sync04 -file "tidelink_gpio_phy_apb_regs.sv" \
      -comment "Independent observability sync flops share the same hresetn by design"

# Pre-existing finding from SPYGLASS_CDC_SIGNOFF.md §2.3 [12D] — poresetn is
# the power-on reset, declared as `reset -name poresetn` at top scope, and
# is synchronized inside u_chiplet_controller by the WavDemetReset cells
# (Wlink internal). The chiplet controller's idelay_rst port consumes it
# directly because IDELAYE2 is async-reset-only. Covered by the
# set_clock_groups -asynchronous declaration in syn/asic.
waive -rule Ac_unsync01 -msg "*idelay_rst*" \
      -comment "POR reset to chiplet controller idelay_rst — sync'd by WavDemetReset inside Wlink"
