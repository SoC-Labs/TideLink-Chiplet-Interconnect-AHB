#-----------------------------------------------------------------------------
# SoCLabs TideLink — SpyGlass CDC Waivers
#
# Suppress CDC violations originating entirely within third-party IP.
# TideLink-authored RTL (src/rtl/**) should NEVER be waived here —
# add targeted waivers with justification comments instead.
#
# Contributors
#
# David Mapstone (d.a.mapstone@soton.ac.uk)
#
# Copyright 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------

# ============================================================================
# Third-party IP: ARM CMSDK
# ============================================================================
# CMSDK AHB-to-SRAM and FPGA SRAM models are single-clock designs with no
# real CDC paths — any flagged crossings are false positives from port-level
# analysis.

waive -du "cmsdk_ahb_to_sram"  -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_fpga_sram"    -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_ahb_to_apb"   -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_apb_slave_mux" -comment "ARM CMSDK IP — single-clock, no real CDC"

# ============================================================================
# Third-party IP: ARM XHB500 bridges
# ============================================================================
# XHB500 bridges are delivered pre-verified for CDC by ARM.  Waive all
# violations within their module hierarchy.

waive -du "xhb500_*" -regexp -comment "ARM XHB500 IP — pre-verified CDC"

# ============================================================================
# Third-party IP: Wlink chiplet controller (Chisel-generated)
# ============================================================================
# Wlink contains its own synchronizers (WavMultibitSync, WavDemetReset,
# WavSyncPulse, etc.) and internal CDC between PLL-generated clocks.
# These are outside TideLink's control.

waive -du "Wlink"              -comment "Wlink top — Chisel-generated, own CDC"
waive -du "Wav*" -regexp       -comment "Wlink primitives — verified CDC cells"
waive -du "Wlink*" -regexp     -comment "Wlink submodules — Chisel-generated"
waive -du "AXI4ToWlink"        -comment "Wlink AXI adapter — Chisel-generated"
waive -du "GeneralBusToWlink"  -comment "Wlink GB adapter — Chisel-generated"
waive -du "ShortPacketToWlink" -comment "Wlink SP adapter — Chisel-generated"
waive -du "TideLinkToWlink"    -comment "Wlink TL adapter — Chisel-generated"
waive -du "APBFanout*" -regexp -comment "Wlink APB fanout — Chisel-generated"
waive -du "wlink_*" -regexp    -comment "Wlink internal modules — Chisel-generated"

# ============================================================================
# Third-party IP: wav_latch_model
# ============================================================================

waive -du "wav_latch_model"    -comment "Wlink latch model — simulation primitive"
