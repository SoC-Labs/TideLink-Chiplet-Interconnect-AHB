#-----------------------------------------------------------------------------
# SoCLabs TideLink — SpyGlass CDC Waivers
#
# Suppress CDC violations originating entirely within third-party IP.
# TideLink-authored RTL (src/rtl/**) should NEVER be waived here —
# add targeted waivers with justification comments instead.
#
# Contributors
#
# David Mapstone (d.a.mapstone@soton.ac.uk)
#
# Copyright 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------

# ============================================================================
# Third-party IP: ARM CMSDK
# ============================================================================
# CMSDK AHB-to-SRAM and FPGA SRAM models are single-clock designs with no
# real CDC paths — any flagged crossings are false positives from port-level
# analysis.

waive -du "cmsdk_ahb_to_sram"  -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_fpga_sram"    -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_ahb_to_apb"   -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_apb_slave_mux" -comment "ARM CMSDK IP — single-clock, no real CDC"

# ============================================================================
# Third-party IP: ARM XHB500 bridges
# ============================================================================
# XHB500 bridges are black-boxed via set_option stop_module in the .prj file.
# Port-level clock domains declared via abstract_port in the SGDC.
# The -du waiver below is retained as a safety net.

waive -du "xhb500_*" -regexp -comment "ARM XHB500 IP — pre-verified CDC"

# ============================================================================
# Third-party IP: Wlink chiplet controller (Chisel-generated)
# ============================================================================
# Wlink contains its own synchronizers (WavMultibitSync, WavDemetReset,
# WavSyncPulse, etc.) and internal CDC between PLL-generated clocks.  Where
# that IP is UNTOUCHED, waiving it is legitimate: it is outside TideLink's
# control and pre-verified by the vendor.
#
# 2026-08-17 — THE BLANKET PATTERNS WERE UNSOUND. WHAT CHANGED AND WHY.
# ----------------------------------------------------------------------------
# This block used to read:
#
#     waive -du "Wlink"              ...
#     waive -du "Wav*"   -regexp     ...
#     waive -du "Wlink*" -regexp     ...
#     waive -du "wlink_*" -regexp    ...
#     waive -du "ShortPacketToWlink" ...
#     waive -du "TideLinkToWlink"    ...
#
# justified as "Chisel-generated, own CDC / outside TideLink's control".
# That justification is FALSE for a large fraction of what those patterns
# matched.  src/rtl/local_overrides/ holds 33 locally-patched module copies;
# 24 of those FILES (23 distinct module names) fall inside the namespaces
# above, and EVERY ONE of them differs from its vendor original — verified by
# byte diff against deps/axi-chiplet-controller/logical/, not by assumption.
# A namespace waiver therefore suppressed CDC findings in TideLink-authored
# logic, on the same paths the project is actively debugging:
#
#   wlink_wlink_ptp_tl_a2l_48x4  — the PTP a2l replay memory. Not a patch at
#       all: the Chisel generator never emitted this model, so the file is
#       SoC-Labs-authored end to end (see its header). "Untouched vendor IP"
#       was never even arguable for it.
#   WlinkGenericFCReplayV2_12/_13 — carry the a2l CDC fix. Their AW/W/B
#       siblings (_1/_3/_5) do NOT carry it and were waived by the same
#       pattern, i.e. the waiver hid precisely the asymmetry that matters.
#   WavMultibitSync_18            — a locally-modified SYNCHRONISER
#       PRIMITIVE, waived under "verified CDC cells". A modified
#       synchroniser is the one thing a CDC waiver must never cover.
#   WlinkGenericFCSM/_1/_2/_3/_4/_6, WlinkRxLinkLayer, Wlink, WavD2DGpio*,
#       WlinkGPIOPHY, WlinkEccSyndrome, WlinkGenericFCReplayAddrSync_18,
#       ShortPacketToWlink, TideLinkToWlink — all locally modified.
#
# THE FIX: waive by explicit module NAME, and only for modules with no copy
# in src/rtl/local_overrides/.  The list below is GENERATED, not hand-typed —
#
#     scripts/cdc/gen_tidelink_waivers.py           # regenerate this block
#     scripts/cdc/gen_tidelink_waivers.py --check   # CI gate, exit 1 on drift
#
# — because a hand list rots the moment someone adds an override, which is
# exactly how the blanket patterns became wrong in the first place.  The
# --check mode fails if ANY `-du` waiver in this file covers a module that
# has a local override, so this hole cannot silently reopen.
#
# ASYMMETRY NOTE: a missing entry here only OVER-reports (a vendor module
# shows real-but-uninteresting internal CDC).  A wrong entry MASKS.  So when
# the vendor drop is updated and new module names appear, prefer to leave
# them unwaived until someone has looked, rather than re-widening to a
# pattern.
#
# Counts at generation time: 104 vendor modules in these namespaces,
# 82 waived below, 22 withheld (locally modified), 1 locally authored.
# ----------------------------------------------------------------------------

waive -du "APBFanout"                          -comment "Wlink vendor IP — unmodified"
waive -du "APBFanout_1"                        -comment "Wlink vendor IP — unmodified"
waive -du "AXI4ToWlink"                        -comment "Wlink vendor IP — unmodified"
waive -du "GeneralBusToWlink"                  -comment "Wlink vendor IP — unmodified"
waive -du "WavAnd"                             -comment "Wlink vendor IP — unmodified"
waive -du "WavClockGate"                       -comment "Wlink vendor IP — unmodified"
waive -du "WavClockInv"                        -comment "Wlink vendor IP — unmodified"
waive -du "WavClockMux"                        -comment "Wlink vendor IP — unmodified"
waive -du "WavD2DRxDLL"                        -comment "Wlink vendor IP — unmodified"
waive -du "WavD2DSerdesPLL"                    -comment "Wlink vendor IP — unmodified"
waive -du "WavD2DSerdesRx"                     -comment "Wlink vendor IP — unmodified"
waive -du "WavD2DSerdesTx"                     -comment "Wlink vendor IP — unmodified"
waive -du "WavDemetReset"                      -comment "Wlink vendor IP — unmodified"
