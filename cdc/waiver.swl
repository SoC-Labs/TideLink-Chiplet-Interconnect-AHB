#-----------------------------------------------------------------------------
# SoCLabs TideLink — SpyGlass CDC Waivers
#
# Suppress CDC violations originating entirely within third-party IP.
# TideLink-authored RTL (src/rtl/**) should NEVER be waived here —
# add targeted waivers with justification comments instead.
#
# Contributors
#
# David Mapstone (d.a.mapstone@soton.ac.uk)
#
# Copyright 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------

# ============================================================================
# Third-party IP: ARM CMSDK
# ============================================================================
# CMSDK AHB-to-SRAM and FPGA SRAM models are single-clock designs with no
# real CDC paths — any flagged crossings are false positives from port-level
# analysis.

waive -du "cmsdk_ahb_to_sram"  -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_fpga_sram"    -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_ahb_to_apb"   -comment "ARM CMSDK IP — single-clock, no real CDC"
waive -du "cmsdk_apb_slave_mux" -comment "ARM CMSDK IP — single-clock, no real CDC"

# ============================================================================
# Third-party IP: ARM XHB500 bridges
# ============================================================================
# XHB500 bridges are black-boxed via set_option stop_module in the .prj file.
# Port-level clock domains declared via abstract_port in the SGDC.
# The -du waiver below is retained as a safety net.

waive -du "xhb500_*" -regexp -comment "ARM XHB500 IP — pre-verified CDC"

# ============================================================================
# Third-party IP: Wlink chiplet controller (Chisel-generated)
# ============================================================================
# Wlink contains its own synchronizers (WavMultibitSync, WavDemetReset,
# WavSyncPulse, etc.) and internal CDC between PLL-generated clocks.
# These are outside TideLink's control.

waive -du "Wlink"              -comment "Wlink top — Chisel-generated, own CDC"
waive -du "Wav*" -regexp       -comment "Wlink primitives — verified CDC cells"
waive -du "Wlink*" -regexp     -comment "Wlink submodules — Chisel-generated"
waive -du "AXI4ToWlink"        -comment "Wlink AXI adapter — Chisel-generated"
waive -du "GeneralBusToWlink"  -comment "Wlink GB adapter — Chisel-generated"
waive -du "ShortPacketToWlink" -comment "Wlink SP adapter — Chisel-generated"
waive -du "TideLinkToWlink"    -comment "Wlink TL adapter — Chisel-generated"
waive -du "APBFanout*" -regexp -comment "Wlink APB fanout — Chisel-generated"
waive -du "wlink_*" -regexp    -comment "Wlink internal modules — Chisel-generated"

# ============================================================================
# Third-party IP: Chiplet Controller (axi_chiplet_controller)
# ============================================================================
# The chiplet controller is black-boxed via set_option stop_module in the .prj
# file, so SpyGlass does not elaborate its internals. Port-level clock domains
# are declared via abstract_port in the SGDC.
#
# The -du waivers below are retained as a safety net — they have no effect when
# the module is black-boxed but will catch violations if stop_module is removed.

waive -du "axi_chiplet_controller" -comment "Chiplet controller wrapper — pre-verified internal CDC"

# I2C sideband controllers (Verilog-RTL I2C from Alex Forencich / Xilinx)
waive -du "i2c_master"         -comment "Third-party I2C master IP — own CDC not required"
waive -du "i2c_master_wbs"     -comment "Third-party I2C master wrapper — Chisel/Bluespec generated"
waive -du "i2c_slave"          -comment "Third-party I2C slave IP — own CDC not required"
waive -du "i2c_slave_axil_master" -comment "Third-party I2C slave AXIL wrapper"
waive -du "axis_fifo"          -comment "Third-party AXIS FIFO — Xilinx IP"

# Bluespec-generated AXI/APB bridges inside chiplet controller
waive -du "mkAXI4_to_AXI4_Lite_Adapter" -comment "Bluespec AXI4-to-AXILite adapter"
waive -du "mkAPB_Master_Xactor" -comment "Bluespec APB master transactor"
waive -du "FIFO2"              -comment "Bluespec FIFO2 primitive"
waive -du "FIFOL1"             -comment "Bluespec FIFOL1 primitive"
waive -du "SizedFIFO"          -comment "Bluespec SizedFIFO primitive"

# ============================================================================
# Third-party IP: wav_latch_model
# ============================================================================

waive -du "wav_latch_model"    -comment "Wlink latch model — simulation primitive"

# ============================================================================
# Crossings into black-boxed chiplet controller
# ============================================================================
# The chiplet controller is black-boxed (stop_module). Remaining crossings at
# its port boundary are handled by the controller's internal CDC logic:
#   - hresetn/poresetn: synchronised by WavDemetReset inside Wlink
#   - I2C bus lines: truly async, synchronised by I2C IP
#   - pad_rx: PHY receive data, synchronised by Wlink SerDes
#   - gb_in: general bus, synchronised by Wlink internal CDC
#
# These waivers use -msg to match the destination module name in the violation
# message text generated by SpyGlass.

waive -rule Ac_unsync01 -msg "*i2c_sda_i*"             -comment "I2C SDA — async external bus, synchronised inside chiplet controller"
waive -rule Ac_unsync01 -msg "*i2c_scl_i*"             -comment "I2C SCL — async external bus, synchronised inside chiplet controller"
waive -rule Ac_unsync01 -msg "*axi_chiplet_controller/hresetn*"  -comment "Reset CDC — synchronised by WavDemetReset inside Wlink"
waive -rule Ac_unsync01 -msg "*axi_chiplet_controller/poresetn*" -comment "POR CDC — synchronised by WavDemetReset inside Wlink"
waive -rule Ac_unsync02 -msg "*pad_rx*"                 -comment "PHY RX data — async recovered clock, synchronised by Wlink SerDes"
waive -rule Ac_unsync02 -msg "*gb_in*"                  -comment "General bus — synchronised by Wlink internal CDC"
