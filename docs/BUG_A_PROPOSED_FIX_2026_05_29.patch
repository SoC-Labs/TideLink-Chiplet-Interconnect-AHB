   wire [7:0] ll_rx_pktnum = auto_rx_in_data[7:0]; // @[FC.scala 123:33]
@@ -425,9 +436,29 @@
   wire [7:0] _GEN_57 = a2l_fc_replay_link_valid & ~fe_rx_is_full ? 16'h7 : word_count; // @[FC.scala 523:63 FC.scala 527:39 FC.scala 429:39]
   wire [55:0] _GEN_58 = a2l_fc_replay_link_valid & ~fe_rx_is_full ? _link_data_in_T : link_data; // @[FC.scala 523:63 FC.scala 528:39 FC.scala 430:39]
   wire [7:0] _GEN_59 = a2l_fc_replay_link_valid & ~fe_rx_is_full ? ne_rx_ptr_next : ne_rx_ptr; // @[FC.scala 523:63 FC.scala 530:39 FC.scala 434:39]
-  wire [2:0] _GEN_60 = a2l_fc_replay_link_valid & ~fe_rx_is_full ? 3'h5 : state; // @[FC.scala 523:63 FC.scala 531:39 FC.scala 424:39]
+  // SoC Labs L8 consumer-side fix (2026-05-29): force LINK_IDLE -> LINK_DATA
+  // when peer is healthily sending data AND CR/CRACK have completed AND L7
+  // is not in NACK-clear mode.  Disarmed permanently after first observation
+  // of state==5 by socl_l8_reached_link_data sticky.  See L8 header block.
+  reg  socl_l8_reached_link_data;
+  wire socl_l8_consumer_data_ready =
+         cr_pkt_seen_tx_demet_io_out
+       & crack_pkt_seen_tx_demet_io_out
+       & socl_l8_peer_data_seen_tx_demet_io_out
+       & ~send_nack_req
+       & ~socl_l7_bringup_forgive
+       & ~socl_l8_reached_link_data;
+  // Original upstream:
+  //   wire [2:0] _GEN_60 = a2l_fc_replay_link_valid & ~fe_rx_is_full ? 3'h5 : state;
+  // L8-patched:
+  wire [2:0] _GEN_60 = (a2l_fc_replay_link_valid & ~fe_rx_is_full)
+                       ? 3'h5
+                       : (socl_l8_consumer_data_ready ? 3'h5 : state);
   wire  _GEN_62 = send_ack_req & _T_54 ? 1'h0 : send_ack_req | (isExpPacket | l2a_fifo_raddr_txclk_update); // @[FC.scala 514:50 FC.scala 516:39 FC.scala 438:39]
   wire  _GEN_63 = send_ack_req & _T_54 | _GEN_55; // @[FC.scala 514:50 FC.scala 517:39]
   wire [7:0] _GEN_64 = send_ack_req & _T_54 ? out_prepend_swi_ack_id : _GEN_56; // @[FC.scala 514:50 FC.scala 518:39]
@@ -880,6 +911,33 @@
       crack_pkt_seen_rx <= pkt_is_crack_pkt | crack_pkt_seen_rx;
     end
   end
+  // SoC Labs L8 consumer-side fix: sticky "peer has sent a data packet".
+  // Same reset convention as L6 cr/crack sticky bits above — POR-only clear
+  // so a transient io_rx_reset re-pulse during bring-up cannot wipe it.
+  always @(posedge io_rx_clk or posedge reset) begin
+    if (reset) begin
+      socl_l8_peer_data_seen_rx <= 1'h0;
+    end else begin
+      socl_l8_peer_data_seen_rx <= pkt_is_data_pkt | socl_l8_peer_data_seen_rx;
+    end
+  end
+  // SoC Labs L8: 2-flop sync of socl_l8_peer_data_seen_rx into io_tx_clk.
+  // Implementation mirrors cr_pkt_seen_tx_demet / crack_pkt_seen_tx_demet
+  // (existing WavDemetReset module).
+  WavDemetReset socl_l8_peer_data_seen_tx_demet (
+    .clock(socl_l8_peer_data_seen_tx_demet_clock),
+    .reset(socl_l8_peer_data_seen_tx_demet_reset),
+    .io_in(socl_l8_peer_data_seen_tx_demet_io_in),
+    .io_out(socl_l8_peer_data_seen_tx_demet_io_out)
+  );
+  // SoC Labs L8: sticky "have we ever reached LINK_DATA" companion to L7.
+  always @(posedge io_tx_clk or posedge io_tx_reset) begin
+    if (io_tx_reset) begin
