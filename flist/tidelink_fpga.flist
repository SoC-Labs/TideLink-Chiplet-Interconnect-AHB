// =============================================================================
// tidelink_fpga.flist — FPGA filelist for tidelink_top (Vivado / iverilog)
//
// SRAM strategy : src/rtl/fifo/fpga/tidelink_sram.sv is a drop-in wrapper
//   around Arm's cmsdk_fpga_sram (BRAM-inferred). Same port signature as
//   the ASIC rf_16k macro — no extra wrapper needed.
// Wlink source  : pre-generated Verilog committed at
//   deps/axi-chiplet-controller/logical/wlink/ (Chisel config:
//   wav.wlink.Wlink8LaneAXI32bitConfig via
//   `make -C deps/axi-chiplet-controller wlink`).
// ASIC-only cells stripped: rf_16k (TSMC 65nm), DFT/scan collateral,
//   ASIC stdcell lib BUFs/clock cells, tidelink_netlist.flist entries.
// Tie-offs / stubs: no separate PUF SRAM — PUF reads share the FIFO SRAM
//   (same tidelink_sram instance inside tidelink_fifo_mem). No scan ports.
// =============================================================================

// Prerequisite: source set_env.sh to set TIDELINK_HOME and CMSDK_DIR before
// invoking Vivado or any other tool with this filelist.

+incdir+${TIDELINK_HOME}/src/rtl
+incdir+${TIDELINK_HOME}/src/rtl/fifo

// ── FIFO subsystem — FPGA variant (BRAM-inferred via cmsdk_fpga_sram) ────────
${CMSDK_DIR}/logical/cmsdk_ahb_to_sram/verilog/cmsdk_ahb_to_sram.v
${CMSDK_FPGA_SRAM_V}
${CMSDK_DIR}/logical/cmsdk_ahb_to_apb/verilog/cmsdk_ahb_to_apb.v
${TIDELINK_HOME}/src/rtl/fifo/fpga/tidelink_sram.sv
${TIDELINK_HOME}/src/rtl/fifo/tidelink_fifo_ctrl.sv
${TIDELINK_HOME}/src/rtl/fifo/tidelink_fifo_mem.sv
${TIDELINK_HOME}/src/rtl/fifo/tidelink_returner.sv
${TIDELINK_HOME}/src/rtl/fifo/tidelink_apb_regs.sv
${TIDELINK_HOME}/src/rtl/fifo/tidelink_fifo.sv
${TIDELINK_HOME}/src/rtl/fifo/tidelink_fifo_ahb.sv

// ── FC adapter ───────────────────────────────────────────────────────────────
