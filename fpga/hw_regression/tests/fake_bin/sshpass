#!/bin/bash
# fake sshpass — routes the "remote" command to the fake board model instead
# of a real PYNQ. The hwlib always invokes:
#   sshpass -p PW ssh [opts...] USER@IP "remote command"
# so the die is identified from the USER@IP token and the remote command is
# the final argument. PATH-prepend tests/fake_bin/ to use (see run_fake_zeropoke.sh).
#
# Match on @IP, NOT on `xilinx@IP`: the login is TD_BOARD_USER-configurable
# (defaults to xilinx). Hardcoding it here would make the fake silently stop
# matching — every die would come back "" and exit 255 — the moment anyone
# ran the suite against a non-xilinx image.
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=SCRIPTDIR/../fake_board_model.sh
source "$HERE/../fake_board_model.sh"

die=""; cmd=""
for a in "$@"; do
  case "$a" in
    *@*4.101) die=die_a;;
    *@*2.101) die=die_b;;
  esac
  cmd="$a"                       # last argument = the remote command string
done
[ -n "$die" ] || exit 255
model_dispatch "$die" "$cmd"
