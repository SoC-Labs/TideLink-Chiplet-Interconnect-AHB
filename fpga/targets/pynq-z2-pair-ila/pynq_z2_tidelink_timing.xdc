# Copyright (C) 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------
# Timing constraints for implementation only. Applying these during synthesis
# fires CRITICAL WARNING 12-4739 ("No valid object(s) found") because the
# clk_wiz output clocks are not visible to the synthesis engine.
#
# Applied via build_design.tcl:
#   set_property USED_IN_SYNTHESIS false [get_files *_timing.xdc]
# (Do NOT add a runtime `set_property USED_IN_SYNTHESIS false [get_files
#  [file normalize [info script]]]` line here — Vivado's XDC parser rejects
#  procedural Tcl commands inside .xdc files; the synth-vs-impl gating
#  must come from build_design.tcl as documented above. Bug fix
#  2026-05-27 (overnight §9.11e session) — see CALIBRATOR_9_11D_HW_MILESTONE
#  for context.)
#-----------------------------------------------------------------------------

#-----------------------------------------------------------------------------
# GPIO PHY pad clocks
#
# The TideLink PHY runs at 50 MHz (source-synchronous: the TX clock is
# forwarded with the data; the RX clock is received from the remote node).
# These clocks are not generated by the MMCM — they come from the PHY pads.
#
# Create virtual clocks for source-synchronous analysis:
#   - tl_tx_clk: 50 MHz, forwarded by TideLink on pad_clk_tx
#   - tl_rx_clk: 50 MHz, received on pad_clk_rx from the remote node
#
# The clk_wiz 50 MHz HCLK output (clk_out1) is the system clock; its
# generated clock is automatically defined by the clk_wiz IP. No
# create_generated_clock call is needed here for hclk.
#-----------------------------------------------------------------------------

# Pin map (2026-04-29): pad_clk_rx is on Y7 (IO_L13P_T2_MRCC_13) and
# pad_clk_tx is on Y6 (IO_L13N_T2_MRCC_13). Both are multi-region
# clock-capable, so dedicated routing is available.

# Input clock from the remote chiplet on pad_clk_rx — 50 MHz, drives the
# pad_rx[*] sampling registers.
create_clock -period 20.000 -name pad_clk_rx [get_ports pad_clk_rx]

# pad_clk_tx is forwarded out of the FPGA from the local hclk domain.
# It's launched by clk_wiz/clk_out1 (the existing 50 MHz domain), so
# Vivado already sees it on the source side; no separate create_clock
# needed for the output.

#-----------------------------------------------------------------------------
# GPIO PHY pad I/O timing (conservative, 50 MHz)
#
# Budget: 5 ns out of a 20 ns period, leaving 15 ns for board trace + setup.
# Tighten once board trace lengths are measured.
#
# pad_tx[*] are output relative to pad_clk_tx (source-synchronous DDR later;
# for first bring-up SDR is sufficient).
# pad_rx[*] are input relative to pad_clk_rx from the remote node.
#-----------------------------------------------------------------------------

# Output delays on TX data lanes relative to the launching hclk
# (clk_wiz/clk_out1). Source-sync SDR centred-eye launch.
set_output_delay -clock [get_clocks -of_objects [get_pins -hier -filter {NAME =~ */clk_wiz_0*/clk_out1}]] -min -5.000 [get_ports {pad_tx[*]}]
set_output_delay -clock [get_clocks -of_objects [get_pins -hier -filter {NAME =~ */clk_wiz_0*/clk_out1}]] -max 5.000 [get_ports {pad_tx[*]}]

# Input delays on RX data lanes relative to pad_clk_rx — centred eye on
# 50 MHz, 20 ns period: data eye spans 1..8 ns from pad_clk_rx edge so
# Vivado adds IODELAY to land the capture flop near the eye centre.
set_input_delay -clock [get_clocks pad_clk_rx] -min 1.000 [get_ports {pad_rx[*]}]
set_input_delay -clock [get_clocks pad_clk_rx] -max 8.000 [get_ports {pad_rx[*]}]

# The forwarded TX clock itself has no setup/hold budget — it is the
# reference clock for the TX domain. Mark it as false-path for timing
# (the MMCM output is the real timing reference; pad_clk_tx is a pure
# clock forward pin with no data timing to analyse at this stage).
set_false_path -to [get_ports pad_clk_tx]

#-----------------------------------------------------------------------------
# Clock domain crossings
#
# The clk_wiz produces two phase-aligned 50 MHz outputs from the same MMCM
# (clk_out1 = hclk, clk_out2 = phc_clk). These are synchronous by
# construction — no CDC path exists between them. Declare this to prevent
# Vivado flagging false CDC warnings across the two outputs.
#-----------------------------------------------------------------------------
# (No set_false_path needed — Vivado automatically treats synchronous outputs
#  of the same MMCM as related clocks. The clk_wiz IP defines this.)

#-----------------------------------------------------------------------------
# False paths
#-----------------------------------------------------------------------------

# LEDs are human-visible; no functional timing path needed.
set_false_path -to [get_ports {led0 led1 led2 led3}]

# pad_clk_rx: incoming clock from remote node — treated as an external clock
# source, not an output to be timed from the MMCM perspective.
# (Already handled by create_clock above; no additional false_path needed.)

#-----------------------------------------------------------------------------
# Combinational loop waivers
#-----------------------------------------------------------------------------

# The IP wrapper hard-wires HSEL=1 and loops HREADYOUT back to HREADY_IN on
# the AHB slaves (ahblite:2.0 sub-signal pattern). This is the standard
# Vivado IP-Integrator AHB-Lite slave style and creates a combinational
# loop on the HREADY net inside the IP. The loop is intentional and
# functionally correct for an always-selected, single-master AHB slave.
# Downgrade LUTLP-1 (combinatorial loop) from ERROR to WARNING for the
# IP-Integrator AHB-Lite HSEL=1 + HREADY loopback pattern. The loop is
# intentional. Resolving via per-net ALLOW_COMBINATORIAL_LOOPS would need
# knowing the auto-generated net hierarchy, which changes between Vivado
# versions; the global severity downgrade is more robust and only relaxes
# this specific DRC.

#-----------------------------------------------------------------------------
# Source-synchronous async clock group
#-----------------------------------------------------------------------------
# pad_clk_rx is asynchronous to the local clk_wiz hclk — it comes from the
# remote chiplet's TX clock with arbitrary phase. Tell Vivado to skip CDC
# analysis between the two domains; Wlink internally synchronises.
set_clock_groups -asynchronous -group [get_clocks pad_clk_rx] -group [get_clocks -of_objects [get_pins -hier -filter {NAME =~ */clk_wiz_0*/clk_out1}]]

