lint_checking file=../deps/xhb500/generated/xhb_chiplet_slv/logical/xhb500_ahb_to_axi_bridge_chiplet_slv/verilog/*
{
    GLTASR off;
    TERMST off;
    RTLINI off;
    OUTRNG off;
