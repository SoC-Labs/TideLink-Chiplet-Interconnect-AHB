# hw_rig.env.example - the RIG facts scripts/hw/hw_test.sh and build.sh need, in one file
#
# Copyright (C) 2026, SoC Labs (www.soclabs.org)
#
# Copy to scripts/hw/hw_rig.env (gitignored; or point HW_ENV_FILE at any file) and edit:
#
#     cp scripts/hw/hw_rig.env.example scripts/hw/hw_rig.env
#     $EDITOR scripts/hw/hw_rig.env
#
# It is SOURCED by bash, so write `export NAME=value` lines.  The values below are PLACEHOLDERS, not any real rig:
# addresses are the RFC 5737 documentation range, the host name never resolves.  Real values belong only in your
# untracked copy.  scripts/ci/site_check.sh (make site-check) keeps absolute site paths out of tracked files.
#
# PASSWORDS ARE NEVER WRITTEN HERE.  hw_test.sh reads them from the environment only, set in your own shell:
#     read -s KR260_PASSWORD && export KR260_PASSWORD            # ssh login of the board image
#     read -s KR260_SUDO_PASSWORD && export KR260_SUDO_PASSWORD  # only if sudo uses a different password
# (the sudo password is fed on stdin: `sudo -S -k -p ''`; it never appears on a command line, in a log or on disk).

# ---- REQUIRED: hw_test.sh refuses to start without these ----------------------------------------
# Lock file shared by EVERYONE who drives these boards.  hw_test.sh holds `flock` on it for the whole run.
# Create it once with `touch`; pick a path on a filesystem all users see (flock must work there).
export KR260_LOCK=/path/to/shared/kr260-rig.lock
# Board 1: hosts BOTH onchip dies (user@ prefix allowed; the user comes from KR260_USER otherwise).
export KR260_IP=192.0.2.10
# Board 2: JTAG POR only; stays unprogrammed.
export KR260_IP2=192.0.2.11
# ssh host that can run the remote JTAG POR tool (must accept key/BatchMode login, no password prompt).
export POR_HOST=por-host.example.invalid

# ---- optional (defaults shown) ----------------------------------------------------------------------
# Command run on $POR_HOST to POR one board; @TARGET@ becomes TGT1 / TGT2.  Wrap in `sg <group> -c '...'` if the
# tool needs a supplementary group on your host.
#export POR_REMOTE_CMD="fpgahub target reset @TARGET@ --yes"
#export TGT1=kr260_01 TGT2=kr260_02       # the POR tool's names for board 1 / board 2
#export KR260_USER=ubuntu                 # login user of the board image
# Text of the hand-off message printed after the final POR (what the rig owner must put back).
#export RIG_RESTORE_NOTE="board 1: <image>; board 2: <image>"
# Where results/ and builds/ go (default <repo>/imp/hw_regress, which is untracked).
#export HW_OUT=/path/to/output
#export LOCK_WAIT=3600                    # seconds to wait for the rig lock
#export BACK_TIMEOUT=240                  # seconds for a board to answer ping after POR

# ---- build.sh only ---------------------------------------------------------------------------------------
# Clean checkout of ptp-hardware-clock-ahb at PHC_PIN_SHA (default 615e2b4).
#export PHC_REPO_DIR=/path/to/ptp-hardware-clock-ahb
#export PHC_PIN_SHA=615e2b4

# ---- run profiles (hw_test.sh knobs; see RUNBOOK.md) ----------------------------------------------------
#export EXPECT_FIXED=1 CRCSTATS=1 STREAM=1     # acceptance of a TL-059 fixed image
#export BRINGUPS=37 STREAM=1                   # N cold bring-ups
