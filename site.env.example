#-----------------------------------------------------------------------------
# site.env.example - the HOST facts a TideLink build needs, in one file
#
# Copyright (C) 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------
# Copy to site.env (gitignored, ONE PER MACHINE) and edit:
#
#     cp site.env.example site.env
#     $EDITOR site.env
#
# It is read from BOTH sides of the build, which is why every line below is
# written in the intersection of Make and POSIX shell syntax:
#
#     set_env.sh          `. ./site.env`        (simulation / IP generation)
#     syn/asic/common.mk  `-include site.env`   (every ASIC flow Makefile)
#
# So: `export NAME=value`, no spaces around `=`, and reference other entries
# as ${NAME} (never $NAME - Make reads that as $(N)AME).
#
# PRECEDENCE: site.env WINS. Both consumers assign plainly, so a line here
# overrides the same name inherited from your login profile or a site module
# file - in the shell and in Make alike. To let the environment through
# instead, comment the line out rather than trying to out-rank it.
#
# The file is optional: absent, both consumers carry on, and whatever the
# environment already holds is what gets used. That is the CI case - a runner
# that sets these as CI/CD variables needs no site.env at all.
#
#-----------------------------------------------------------------------------
# WHY THERE ARE NO REAL PATHS IN THIS FILE
#
# The paths below are SHAPES, not this site's. Two disclosure classes are
# deliberately absent from every tracked file in this repository, and putting
# either one back into a tracked file undoes the point of this file:
#
#   1. ABSOLUTE SITE PATHS. A committed mount point publishes one institution's
#      filesystem layout, and it is a path that resolves on exactly one machine
#      besides.
#   2. REVISION-CODED VENDOR RELEASE NAMES. A library FAMILY name is public.
#      A release-suffixed drop name, a PVT-encoded Liberty/.db stem, a
#      metal-stack option code or a signoff-deck revision is an inventory of
#      what this site is licensed for - commercial information about a
#      licensee, not anything the flow needs written down.
#
# NOTHING BELOW HAS A FALLBACK, deliberately. A default pointing at one lab's
# mount is a run that LOOKS configured and is not: it fails five hours in,
# reading as a missing file rather than as a missing setting. Unset, each
# consumer names the variable instead - `make -C syn/asic/fusion-compiler
# site-check` lists every one that is missing, in one pass, without a licence.
#
# HOST FACTS ARE NOT SECRETS. The test is: would two machines at the same site
# need different values (-> host fact, it belongs here), or would two people on
# the same machine need different values (-> secret, it belongs in the CI
# platform's secret store)? By that test every entry below is a host fact.
#-----------------------------------------------------------------------------


#-----------------------------------------------------------------------------
# 1. EDA TOOLS
#
# Either point these at the install roots, or delete them and put the tools on
# PATH from your site's module file - the Makefiles only prepend these to PATH.
#-----------------------------------------------------------------------------
# Simulation (cocotb / UVM / xprop)
# export VCS_HOME=/path/to/synopsys/vcs/<version>
# export VERDI_HOME=/path/to/synopsys/verdi/<version>
# export VIP_HOME=/path/to/synopsys/vc-vip/<version>

# Lint / CDC
# export SPYGLASS_HOME=/path/to/synopsys/spyglass/<version>/SPYGLASS_HOME
# export XCELIUM_HOME=/path/to/cadence/xcelium          # provides the HAL linter

# ASIC implementation + signoff (bin/ directories, prepended to PATH)
# export FC_BIN_DIR=/path/to/synopsys/fusion-compiler/<version>/bin
# export ICC2_BIN_DIR=/path/to/synopsys/icc2/<version>/bin
# export LC_BIN_DIR=/path/to/synopsys/library-compiler/<version>/bin
# export FM_BIN_DIR=/path/to/synopsys/formality/<version>/bin
# export PT_BIN_DIR=/path/to/synopsys/primetime/<version>/bin
# export RTLA_BIN_DIR=/path/to/synopsys/rtl-architect/<version>/bin

# RTL Architect reference methodology (the RM tarball, unpacked)
# export RTLA_RM_PATH=/path/to/synopsys/RTLA-RM/<version>

# Calibre executable (the Makefile derives calibre/ and v2lvs/ from its dirname)
# export CAL_BIN=/path/to/mentor/calibre/bin/calibre


#-----------------------------------------------------------------------------
# 2. ARM IP
#
# ARM_IP_LIBRARY_PATH is the root of the Arm IP collection; the three package
# variables below are set individually because their subdirectory names carry
# release codes that differ per licensee and must not be committed.
#-----------------------------------------------------------------------------
# export ARM_IP_LIBRARY_PATH=/path/to/arm/ip_library

# Cortex-M System Design Kit (cmsdk_ahb_to_sram, cmsdk_fpga_sram)
# export CMSDK_DIR=${ARM_IP_LIBRARY_PATH}/<cmsdk-package>

# cmsdk_fpga_sram.v is absent from some CMSDK packages. Set this ONLY if the
# file does not live at ${CMSDK_DIR}/logical/models/memories/cmsdk_fpga_sram.v;
# set_env.sh derives it from CMSDK_DIR when it does.
# export CMSDK_FPGA_SRAM_V=${ARM_IP_LIBRARY_PATH}/<other-package>/logical/models/memories/cmsdk_fpga_sram.v

# XHB-500 AHB/AXI bridge generator bundle (set_env.sh runs logical/generate)
# export XHB500_IP_DIR=${ARM_IP_LIBRARY_PATH}/<xhb500-package>/xhb500

# Arm physical IP root, and the two Artisan drops the chip-top flow references.
# PMK/RET are used by the integrating chip-top only - the tidelink partition
# does not instantiate them, so they may be left unset here.
# export PHYS_IP_PATH=/path/to/arm/phys_ip_library/<vendor>/<process>
# export PMK_BASE_PATH=/path/to/arm/phys_ip_library/<vendor>/<process>/<pmk-drop>
# export RET_BASE_PATH=/path/to/arm/phys_ip_library/<vendor>/<process>/<ret-drop>

# Arm Artisan collateral used by the RTL Architect flow. The LEF path carries
# the library variant and the drop revision; the two Liberty LIBRARY NAMES and
# the two operating-condition labels encode the PVT characterisation corner.
# All four are names as they appear inside the .db, not paths.
# export RTLA_LEF_FILE=${PHYS_IP_PATH}/<library>/<revision>/lef/<library>.lef
# export RTLA_OC_SS=<slow-corner-operating-condition>
# export RTLA_OC_FF=<fast-corner-operating-condition>
# export RTLA_LIB_NAME_SS=<library>_<slow-corner>
# export RTLA_LIB_NAME_FF=<library>_<fast-corner>


#-----------------------------------------------------------------------------
# 3. FOUNDRY STANDARD-CELL LIBRARY
#
# STANDARD_CELL_BASE_PATH is the install root (the directory holding Front_End/
# and Back_End/). Everything under it is named individually rather than
# assembled from it, because each of those subdirectory and file names carries
# a release code, a metal-stack option code or a PVT characterisation corner.
#-----------------------------------------------------------------------------
# export STANDARD_CELL_BASE_PATH=/path/to/pdk/stdcell/<library>/<release>/digital
# export CLN65LP_TECH_PATH=${STANDARD_CELL_BASE_PATH}/Back_End   # default; rarely overridden

# Physical views. TF_FILE and STANDARD_CELL_LEF_FILE must describe the SAME
# metal stack - a mismatch is not diagnosed by the tools, it just routes wrong.
# export TF_FILE=${STANDARD_CELL_BASE_PATH}/Back_End/milkyway/<release>/techfiles/<stack>.tf
# export STANDARD_CELL_LEF_FILE=${STANDARD_CELL_BASE_PATH}/Back_End/lef/<release>/lef/<library>_<stack>.lef
# export MW_REF_LIB=${STANDARD_CELL_BASE_PATH}/Back_End/milkyway/<release>/frame_only/<library>

# Timing. DB_PATH is the NLDM directory; the three stems encode the PVT corner.
# export DB_PATH=${STANDARD_CELL_BASE_PATH}/Front_End/timing_power_noise/NLDM/<release>
# export DB_SS=${DB_PATH}/<library><slow-corner>.db
# export DB_TT=${DB_PATH}/<library><typ-corner>.db
# export DB_FF=${DB_PATH}/<library><fast-corner>.db

# Liberty LIBRARY NAMES (not paths) as they appear inside the .db, for the
# MCMM setup in syn/asic/scripts/tidelink.FC.read_design.tcl. These also encode
# the PVT corner, so they are configured rather than committed.
# export FC_LIB_NAME_SS=<library><slow-corner>
# export FC_LIB_NAME_FF=<library><fast-corner>

# Gate-level simulation models
# export STDCELL_VERILOG=${STANDARD_CELL_BASE_PATH}/Front_End/verilog/<release>

# Parasitic extraction. TLUPLUS_MAP's filename encodes the metal count, and
# FC_TLU_STACK is the filename STEM of the TLU+ files themselves, which encodes
# the metal-stack option: the flow reads <stem>_typical_top2.tluplus and its
# rcbest/rcworst siblings out of TLUPLUS_PATH. FC_TLU_STACK must describe the
# same stack as TF_FILE — a mismatched TLU+ set is read without complaint and
# extracts the wrong parasitics.
# export TLUPLUS_PATH=${STANDARD_CELL_BASE_PATH}/Back_End/milkyway/<release>/techfiles/tluplus
# export TLUPLUS_MAP=${TLUPLUS_PATH}/<layer-map>
# export FC_TLU_STACK=<process>_<stack-option>

# GDS stream-out layer map (filename encodes the metal-stack option)
# export GDS_LAYER_MAP=${STANDARD_CELL_BASE_PATH}/Back_End/milkyway/<release>/<gdsout-map>

# OPTIONAL. Leave unset unless your install ships them. STANDARD_CELL_GDS_FILE
# unset means write_gds skips the std-cell merge, which is correct when the
# foundry ships cell layout only in the signoff package.
# export STANDARD_CELL_GDS_FILE=
# export STANDARD_CELL_ANTENNA_FILE=


#-----------------------------------------------------------------------------
# 4. FOUNDRY IO LIBRARY
#
# Chip-top pad ring only. The tidelink partition instantiates no pads, so these
# may be left unset; tech_paths.tcl reports them as unset rather than failing.
#-----------------------------------------------------------------------------
# export IO_BASE_PATH=/path/to/pdk/iolib/<library>/<release>/digital
# export IO_LEF_FILE=${IO_BASE_PATH}/Back_End/lef/<release>/<option>/<stack>/lef/<library>_<stack>.lef
# export IO_GDS_FILE=${IO_BASE_PATH}/gds2/<library>.gds2
# export IO_DB_SS=${IO_BASE_PATH}/Front_End/timing_power_noise/NLDM/<release>/<library><slow-corner>.db
# export IO_DB_TT=${IO_BASE_PATH}/Front_End/timing_power_noise/NLDM/<release>/<library><typ-corner>.db
# export IO_DB_FF=${IO_BASE_PATH}/Front_End/timing_power_noise/NLDM/<release>/<library><fast-corner>.db
# export IO_ANTENNA_FILE=${IO_BASE_PATH}/milkyway/<stack>/<library>_antenna.clf


#-----------------------------------------------------------------------------
# 5. COMPILED MEMORY MACROS
#
# MEM_BASE is the root of the precompiled-macro tree; MEM_PATH is the rf_16k
# directory inside it (tidelink_top instantiates exactly one rf_16k).
#-----------------------------------------------------------------------------
# export MEM_BASE=/path/to/precompiled_mems/<process>
# export MEM_PATH=${MEM_BASE}/rf_16k
# export MEM_CTL_FILE=${MEM_PATH}/rf_16k.ctl        # CTL test model, MBIST only


#-----------------------------------------------------------------------------
# 6. SIGNOFF DECKS
#
# A deck FILENAME encodes the node, the RDL option, the UTM variant, the deck
# version and the metal count - i.e. exactly which signoff release this site
# holds - so it is configured, never committed.
#-----------------------------------------------------------------------------
# export CALIBRE_DRC_DECK=/path/to/pdk/util/MAIN_DECK/CALIBRE_FLOW/<variant>/<deck>
# export CALIBRE_LVS_DECK=/path/to/pdk/Calibre/lvs/calibre.lvs
# export CALIBRE_LVS_SOURCE_ADDED=/path/to/pdk/Calibre/lvs/source.added

# OPT-IN: the ICV signoff DRC runset for this process, if your install ships
# one. Unset, fusion-compiler/scripts/7_drc.tcl runs its built-in checks only
# and says so; it does not pretend to have run signoff DRC.
# export ICV_DRC_RUNSET=/path/to/pdk/icv/<runset>.rs
# export ICV_DRC_STRATEGY=


#-----------------------------------------------------------------------------
# 7. PROJECT SIBLINGS
#
# Only needed for the co-simulation suites that elaborate against a sibling
# repository. SIM_GATE_REQUIRE fails those suites loudly when unset - it is
# never a silent skip.
#-----------------------------------------------------------------------------
# export TIDECHART_HOME=/path/to/tidechart
# export CHIPLET_HOME=/path/to/nanosoc-ethernet-chiplet
# export ETH_SS_HOME=/path/to/ethernet-subsystem-ahb

# The integrating chip-top project, if you are building tidelink as a partition
# of one. tech_paths.tcl resolves the chip-top-only macros (sram_32k, bootrom)
# under ${SOCLABS_PROJECT_DIR}/memories/. Unset, it falls back to TIDELINK_HOME,
# which is correct for a standalone partition run.
# export SOCLABS_PROJECT_DIR=/path/to/parent-project


#-----------------------------------------------------------------------------
# 8. NOT A SITE FACT - listed here only so nobody moves it in
#
# FC_PG_RAIL_WIDTH (μm) overrides the M1 follow-pin nominal in
# fusion-compiler/scripts/pg_mesh.tcl. It has a committed default because it is
# a value this design chose to make via stacks land - it is NOT a foundry
# minimum and nothing was read out of a library to obtain it. Set it here only
# if your cells' M1 PG rail geometry differs enough that via stacks miss.
#
# The same goes for FC_PG_PITCH (μm), the M5/M6 mesh pitch. Both are design
# decisions with measured consequences recorded next to them in the script.
# export FC_PG_RAIL_WIDTH=
# export FC_PG_PITCH=
