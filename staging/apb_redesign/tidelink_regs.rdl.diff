--- a/src/rdl/tidelink_regs.rdl
+++ b/src/rdl/tidelink_regs.rdl
@@ -315,5 +315,196 @@
         prescale->sw = rw;
         prescale->hw = r;
     };
     i2c_prescale_reg i2c_prescale @ 0x08C;
+
+    // =========================================================================
+    // Region 4 (continued): Auto-negotiation control (paddr[7:5]=100, slot[4:7])
+    // (Existing registers — no change from current chiplet-controller layout
+    //  in axi_chiplet_controller.sv:419-422; declared here for RDL parity.)
+    // =========================================================================
+
+    reg nego_cfg_reg {
+        name = "Auto-Negotiation Configuration";
+        desc = "Configuration bits for the autoneg FSM.
+                bit[0] = nego_en, bit[6] = mask_hs_auto_en.";
+        field {} cfg[7] = 0;
+        cfg->sw = rw;
+        cfg->hw = r;
+    };
+    nego_cfg_reg nego_cfg @ 0x090;
+
+    reg nego_status_reg {
+        name = "Auto-Negotiation Status";
+        desc = "Live status of the autoneg FSM. Read-only.";
+        field {} state[4] = 0;
+        state->sw = r;
+        state->hw = w;
+        field {} done[1] = 0;
+        done->sw = r;
+        done->hw = w;
+        field {} error[1] = 0;
+        error->sw = r;
+        error->hw = w;
+        field {} won[1] = 0;
+        won->sw = r;
+        won->hw = w;
+        field {} lost[1] = 0;
+        lost->sw = r;
+        lost->hw = w;
+        field {} sda_start_seen[1] = 0;
+        sda_start_seen->sw = r;
+        sda_start_seen->hw = w;
+        field {} mask_mismatch[1] = 0;
+        mask_mismatch->sw = r;
+        mask_mismatch->hw = w;
+    };
+    nego_status_reg nego_status @ 0x094;
+
+    reg nego_priority_reg {
+        name = "Auto-Negotiation Priority";
+        desc = "16-bit priority value sent during NEGO_CLAIM. Lower wins.";
+        field {} priority[16] = 16'hFFFF;
+        priority->sw = rw;
+        priority->hw = r;
+    };
+    nego_priority_reg nego_priority @ 0x098;
+
+    reg nego_timeout_reg {
+        name = "Auto-Negotiation Timeout";
+        desc = "Cycle-count timeout for the autoneg FSM.";
+        field {} timeout[32] = 32'd131_082_000;
+        timeout->sw = rw;
+        timeout->hw = r;
+    };
+    nego_timeout_reg nego_timeout @ 0x09C;
+
+    // =========================================================================
+    // Region 8: Chiplet Extended — PHY Alignment & I²C Training
+    //   paddr[8:5] = 4'b1000, offsets 0x100..0x11F.
+    //   Decoded by a 4-bit region select (paddr[8:5]); existing Regions 0..7
+    //   keep their 3-bit decode (paddr[7:5] with paddr[8]=0).
+    //   See staging/apb_redesign/PROPOSAL.md for full design rationale.
+    // =========================================================================
+
+    reg swi_training_mode_reg {
+        name = "SWI Training Mode";
+        desc = "Drives the Wlink GPIO PHY's training pattern + lane-checker
+                enable. Writable from both local APB and the I²C-slave AXIL
+                bridge (peer-driven). POR-only reset domain (survives warm
+                hresetn so training state persists across system reset).";
+        field {} swi_training_mode[1] = 0;
+        swi_training_mode->sw = rw;
+        swi_training_mode->hw = r;
+        swi_training_mode->desc = "1 = TX serialiser emits per-lane training
+                                    pattern; lane-checker FSM evaluates;
+                                    LL TX/RX held off via swi_lltx/llrx gating.";
+    };
+    swi_training_mode_reg swi_training_mode @ 0x100;
+
+    reg swi_bit_slip_lo_reg {
+        name = "SWI Bit Slip (Low)";
+        desc = "Per-lane bit-slip for the 8 PHY RX lanes, packed 3 bits per
+                lane (lane K at bits [3K+2:3K]). SW override of the
+                autonomous calibration FSM's per-lane slip value. When
+                NEGO_TRAIN_CFG.train_auto_en=1 AND swi_calibration_done=0,
+                the cal FSM owns slip; otherwise SW override applies.";
+        field {} bit_slip[24] = 0;
+        bit_slip->sw = rw;
+        bit_slip->hw = r;
+        bit_slip->desc = "8 lanes × 3-bit right-rotation amount for the
+                          deserialised 16-bit word.";
+    };
+    swi_bit_slip_lo_reg swi_bit_slip_lo @ 0x104;
+
+    reg swi_lane_status_reg {
+        name = "SWI Lane Status";
+        desc = "Read-only per-lane lock + fault + calibration done status.
+                Packed so an I²C 4-byte read captures all three signals in
+                one transaction (byte 0 = lane_locked, byte 1 = lane_fault,
+                byte 2 = calibration_done, byte 3 = reserved).";
+        field {} lane_locked[8] = 0;
+        lane_locked->sw = r;
+        lane_locked->hw = w;
+        lane_locked->desc = "Per-lane lock status from the wlink_lane_checker.
+                              Bit K = 1 means lane K has met the lock threshold.";
+        field {} lane_fault[8] = 0;
+        lane_fault->sw = r;
+        lane_fault->hw = w;
+        lane_fault->desc = "Per-lane sticky fault. Set when the cal FSM
+                            exhausts the slip sweep without locking.";
+        field {} calibration_done[1] = 0;
+        calibration_done->sw = r;
+        calibration_done->hw = w;
+        calibration_done->desc = "Set by the cal FSM at convergence.
+                                   Cleared by swreset or train_retrain.";
+    };
+    swi_lane_status_reg swi_lane_status @ 0x108;
+
+    reg nego_train_cfg_reg {
+        name = "Nego Train Configuration";
+        desc = "I²C-coordinated training-mode handshake configuration.";
+        field {} train_auto_en[1] = 0;
+        train_auto_en->sw = rw;
+        train_auto_en->hw = r;
+        train_auto_en->desc = "Enable autoneg FSM's training sub-flow.";
+        field {} train_sw_step[1] = 0;
+        train_sw_step->sw = rw;
+        train_sw_step->hw = r;
+        train_sw_step->desc = "Single-step mode for debug. FSM advances one
+                                state per write to NEGO_TRAIN_STEP.";
+        field {} train_retrain[1] = 0;
+        train_retrain->sw = rw;
+        train_retrain->hw = r;
+        train_retrain->singlepulse;
+        train_retrain->desc = "W1P pulse: re-enters ST_TRAIN_ENTER from
+                                ST_TRAIN_DONE/FAIL. Self-clearing.";
+        field {} train_poll_timeout[4] = 0;
+        train_poll_timeout->sw = rw;
+        train_poll_timeout->hw = r;
+        train_poll_timeout->desc = "Number of poll attempts before fail.
+                                     0 → use default (16).";
+        field {} train_fsm_wait_hi[8] = 0;
+        train_fsm_wait_hi->sw = rw;
+        train_fsm_wait_hi->hw = r;
+        train_fsm_wait_hi->desc = "High 8 bits of T_TRAIN_FSM ÷ 16 cycles.
+                                    Full wait = {train_fsm_wait_hi, 4'h0}.";
+    };
+    nego_train_cfg_reg nego_train_cfg @ 0x10C;
+
+    reg nego_train_status_reg {
+        name = "Nego Train Status";
+        desc = "Live status of the training sub-flow + last-captured peer
+                fault/lock values.";
+        field {} train_ok[1] = 0;
+        train_ok->sw = r;
+        train_ok->hw = w;
+        field {} train_fail[1] = 0;
+        train_fail->sw = r;
+        train_fail->hw = w;
+        field {} train_in_progress[1] = 0;
+        train_in_progress->sw = r;
+        train_in_progress->hw = w;
+        field {} train_peer_nack[1] = 0;
+        train_peer_nack->sw = r;
+        train_peer_nack->hw = w;
+        field {} train_state[4] = 0;
+        train_state->sw = r;
+        train_state->hw = w;
+        train_state->desc = "Mirror of ST_TRAIN_* encoding (0..6).";
+        field {} train_peer_lane_locked[8] = 0;
+        train_peer_lane_locked->sw = r;
+        train_peer_lane_locked->hw = w;
+        field {} train_peer_lane_fault[8] = 0;
+        train_peer_lane_fault->sw = r;
+        train_peer_lane_fault->hw = w;
+        field {} train_local_lane_fault[8] = 0;
+        train_local_lane_fault->sw = r;
+        train_local_lane_fault->hw = w;
+    };
+    nego_train_status_reg nego_train_status @ 0x110;
+
+    reg nego_train_step_reg {
+        name = "Nego Train Step";
+        desc = "W1P single-step pulse for debug. Effective only when
+                NEGO_TRAIN_CFG.train_sw_step=1.";
+        field {} step[1] = 0;
+        step->sw = rw;
+        step->hw = r;
+        step->singlepulse;
+    };
+    nego_train_step_reg nego_train_step @ 0x114;
+
+    reg swi_bit_slip_hi_reg {
+        name = "SWI Bit Slip (High) — reserved";
+        desc = "Reserved for future 16-lane PHY builds. Reads-as-zero in
+                8-lane builds. Held as RW so SW can probe for the slot.";
+        field {} bit_slip_hi[24] = 0;
+        bit_slip_hi->sw = rw;
+        bit_slip_hi->hw = r;
+    };
+    swi_bit_slip_hi_reg swi_bit_slip_hi @ 0x118;
+
+    reg phy_align_id_reg {
+        name = "PHY Alignment Block ID";
+        desc = "Read-only identification. [31:16] = 0x5041 ('PA'),
+                [15:8] = major version, [7:0] = minor version.
+                Current value: 0x5041_0100 (v1.0). SW uses this to confirm
+                Region 8 exists before issuing reads to its other registers.";
+        field {} id[32] = 32'h50410100;
+        id->sw = r;
+        id->hw = na;
+    };
+    phy_align_id_reg phy_align_id @ 0x11C;
 };
