# --------------------------------------------------------------------------
# Auto-regenerate the GPIO Wlink Verilog if missing or older than the Scala.
# output_tidelink_gpio/ is gitignored, so each fresh checkout starts empty
# and the Scala edits in src/main/scala may render the previous output
# stale. Compile depends on $(WLINK_GEN_V); the rule invokes sbt only when
# the file is missing or out of date.
# --------------------------------------------------------------------------
WLINK_HW_DIR  := $(DEPS_DIR)/wav-wlink-hw
WLINK_GEN_DIR := $(WLINK_HW_DIR)/output_tidelink_gpio
WLINK_GEN_V   := $(WLINK_GEN_DIR)/Wlink.v
WLINK_CONFIG  := wav.wlink.Wlink8LaneAXI32bitTideLinkConfig
WLINK_SCALA   := $(wildcard $(WLINK_HW_DIR)/src/main/scala/*.scala)

$(WLINK_GEN_V): $(WLINK_SCALA)
	@echo "Regenerating Wlink Verilog ($(WLINK_CONFIG)) into $(WLINK_GEN_DIR)..."
	cd $(WLINK_HW_DIR) && \
	  sbt 'runMain wav.wlink.WlinkGen -o $(WLINK_GEN_DIR) -c $(WLINK_CONFIG)'

.PHONY: wlink_regen
wlink_regen: $(WLINK_GEN_V)

# GATE=1 uses the flattened FC netlist, so the Chisel-generated Wlink
# Verilog isn't a prerequisite (it's already baked into the netlist);
# instead, the probe-free gate TB must be regenerated from top.sv.
ifeq ($(GATE),1)
COMPILE_DEPS = $(TB_DIR)/top_gate.sv
SIM_DIR      = sim_build_gate
else
# 2026-07 un-rot: the sbt-regenerated output_tidelink_gpio is no longer used
# (dropped as a -y search dir above — its WlinkRxLinkLayer lacks the io_obs_*
# ports the committed logical/wlink set drives). Do NOT gate `compile` on the
# ~7-min sbt Wlink regen; it produced only stale Verilog. Run `make wlink_regen`
# explicitly if you ever need that output. Env is QUARANTINED (see TESTS note).
COMPILE_DEPS =
endif

# Derive the probe-free gate TB from top.sv, then assert the strip
# actually worked: zero residual XMR tokens AND run_test() preserved.
# Regenerated whenever top.sv or the generator changes.
$(TB_DIR)/top_gate.sv: $(TB_DIR)/top.sv $(TB_DIR)/gen_gate_tb.awk
	@echo "Generating probe-free gate TB: $@"
	@awk -f $(TB_DIR)/gen_gate_tb.awk $(TB_DIR)/top.sv > $@.tmp
	@if grep -qE 'u_tidelink_top_[ab]\.' $@.tmp; then \
		echo "ERROR: gate TB still has XMR refs — gen_gate_tb.awk under-stripped:"; \
		grep -nE 'u_tidelink_top_[ab]\.' $@.tmp | head -5; \
		rm -f $@.tmp; exit 1; \
	fi
	@if ! grep -q 'run_test(' $@.tmp; then \
		echo "ERROR: gate TB lost run_test() — gen_gate_tb.awk over-stripped"; \
		rm -f $@.tmp; exit 1; \
	fi
	@mv $@.tmp $@
	@echo "  OK: 0 XMR refs, run_test() preserved ($$(wc -l < $@) lines, was $$(wc -l < $(TB_DIR)/top.sv))"

compile: $(COMPILE_DEPS) $(DUT_FLIST) | $(SIM_DIR)
	$(VCS) $(VCS_FLAGS)

$(SIM_DIR):
	mkdir -p $(SIM_DIR)

# ---------------------------------------------------------------
# I1 sim-repro: generate the DUT flist variant selected by FCSM_SRC from the
# shipping V2 FPGA filelist. `local` is verbatim (FCSM 0-4 already point at the
# local_overrides recovery copies — the shipping I1 override). `deps` re-points
# ONLY the 5 muxed AXI FC nodes (WlinkGenericFCSM{,_1..4}) to the pristine deps
# submodule (recovery-stripped baseline); FCSM_5 stays deps, FCSM_6 stays the
# local L6 producer-side fix in BOTH variants — so the ONLY delta is the AXI
# nodes' recovery/L6-L7 hold footprint on the shared WlinkTxRouter arbiter.
# SOCL_L6_MIN_CR_EMITS stays at its shipping localparam default (8'd32).
$(SIM_DIR)/dut_fcsm_local.flist: $(FLIST_DIR)/tidelink_fpga_v2.flist | $(SIM_DIR)
	cp $< $@

$(SIM_DIR)/dut_fcsm_deps.flist: $(FLIST_DIR)/tidelink_fpga_v2.flist | $(SIM_DIR)
	sed -E 's#src/rtl/local_overrides/(WlinkGenericFCSM(_[1-4])?\.v)#deps/axi-chiplet-controller/logical/wlink/\1#' $< > $@

# FCSM_SRC=fix : the override AXI nodes 0-4 REPLACED by the REFUTED emit-gate
# fix (fix/i1-fcsm-bringup @ e79a5b8) — the socl_reached_link_idle latch that
# holds the L6/L7 emit gate OPEN until the first LINK_IDLE. Compiled WITHOUT
# +define+SOCL_FCSM_BRINGUP_HOLD_ALWAYS, i.e. the fix as shipped on that branch.
# Trust-gate (c): silicon says this fix does NOT recover I1, so a FAITHFUL sim
# must STAY RED with it; if it GREENs, this env is reproducing the emit-gate
# livelock rather than the true silicon cause. Files pinned under i1fix_fcsm/.
$(SIM_DIR)/dut_fcsm_fix.flist: $(FLIST_DIR)/tidelink_fpga_v2.flist | $(SIM_DIR)
	sed -E 's#\$$\{TIDELINK_HOME\}/src/rtl/local_overrides/(WlinkGenericFCSM(_[1-4])?\.v)#$(CURDIR)/i1fix_fcsm/\1#' $< > $@

run: compile
	cd $(SIM_DIR) && ./simv $(SIM_FLAGS) -cm_dir $(abspath $(TL_CM_DIR)) -cm_name uvm_top_system__$(TEST)

waves: VCS_FLAGS += +define+WAVES_VCD
waves: run

run_all: compile
	@pass=0; fail=0; \
	for test in $(TESTS); do \
		echo "======== Running $$test ========"; \
		if cd $(SIM_DIR) && ./simv +UVM_TESTNAME=$$test +UVM_VERBOSITY=$(VERBOSITY) \
			-cm line+cond+tgl+fsm+branch -cm_dir $(abspath $(TL_CM_DIR)) -cm_name uvm_top_system__$$test \
			+ntb_random_seed_automatic -l $$test.log; then \
			echo "  PASSED: $$test"; \
			pass=$$((pass + 1)); \
		else \
			echo "  FAILED: $$test"; \
			fail=$$((fail + 1)); \
		fi; \
		cd ..; \
	done; \
	echo "======== All tests complete: $$pass passed, $$fail failed ========"; \
	exit $$fail

coverage:
	$(VCS_HOME)/bin/urg -dir $(TL_CM_DIR) -report $(COV_DIR) -format both

clean:
	rm -rf $(SIM_DIR) $(COV_DIR) csrc *.log ucli.key vc_hdrs.h

# ===========================================================================
# Scoreboard self-test (false-green register B1/B2 control)
# ---------------------------------------------------------------------------
# The env above is QUARANTINED — it does not elaborate, because of DUT/TB port
# rot. The SCOREBOARD, however, is a pure UVM component with no RTL
# dependency: it only needs UVM and the AMBA VIP transaction types. This
# target compiles the production scoreboard SOURCE FILE (no copy) with no
# design under test and drives its verdict path directly, so the checker stays
# executable while the env is quarantined.
#
#   make sb_selftest    - compile and run; nonzero exit on any UVM_ERROR
# ===========================================================================
SELFTEST_DIR = $(CURDIR)/selftest
SELFTEST_SIM = sim_build_sb_selftest

VCS_SELFTEST  = -full64 -sverilog -ntb_opts uvm-1.2 -timescale=1ns/1ps
VCS_SELFTEST += +define+DESIGNWARE_INCDIR=$(VIP_HOME)
VCS_SELFTEST += +define+UVM_DISABLE_AUTO_ITEM_RECORDING
VCS_SELFTEST += +define+SVT_AHB_DISABLE_IMPLICIT_BUS_CONNECTION
VCS_SELFTEST += +incdir+$(VCS_HOME)/etc/uvm-1.2
VCS_SELFTEST += +incdir+$(SVT_HOME)/sverilog/include
VCS_SELFTEST += +incdir+$(AMBA_HOME)/sverilog/include
VCS_SELFTEST += +incdir+$(ENV_DIR) +incdir+$(SELFTEST_DIR)
VCS_SELFTEST += -y $(SVT_HOME)/sverilog/src/vcs -y $(SVT_HOME)/sverilog/src/com
VCS_SELFTEST += -y $(AMBA_HOME)/sverilog/src/vcs -y $(AMBA_HOME)/sverilog/src/com
VCS_SELFTEST += +libext+.svp+.sv+.svi+.svh
VCS_SELFTEST += $(SELFTEST_DIR)/tl_top_sb_selftest_top.sv
VCS_SELFTEST += -l $(SELFTEST_SIM)/compile.log -o $(SELFTEST_SIM)/simv

.PHONY: sb_selftest clean_sb_selftest

sb_selftest:
	@rm -rf $(SELFTEST_SIM)
	@mkdir -p $(SELFTEST_SIM)
	@DESIGNWARE_HOME=$(VIP_HOME) $(VCS_HOME)/bin/vcs $(VCS_SELFTEST)
	@DESIGNWARE_HOME=$(VIP_HOME) ./$(SELFTEST_SIM)/simv \
	    +UVM_TESTNAME=tl_top_sb_selftest +UVM_VERBOSITY=UVM_LOW \
	    -l $(SELFTEST_SIM)/sb_selftest.log > /dev/null
	@# simv exits 0 even with UVM_ERROR > 0. Decide on the log, not the
	@# exit code, and treat a missing/unparseable log as FAIL, not PASS.
	@if [ ! -s $(SELFTEST_SIM)/sb_selftest.log ]; then \
	    echo "SB_SELFTEST: COULD-NOT-EVALUATE (no log)"; exit 2; \
	fi
	@if ! grep -q '^UVM_ERROR *:' $(SELFTEST_SIM)/sb_selftest.log; then \
	    echo "SB_SELFTEST: COULD-NOT-EVALUATE (no UVM report summary in log)"; exit 2; \
	fi
	@n=$$(sed -n 's/^UVM_ERROR *: *\([0-9][0-9]*\).*/\1/p' $(SELFTEST_SIM)/sb_selftest.log | tail -1); \
	 f=$$(sed -n 's/^UVM_FATAL *: *\([0-9][0-9]*\).*/\1/p' $(SELFTEST_SIM)/sb_selftest.log | tail -1); \
	 grep -E '^UVM_(INFO|ERROR).*\[SB_SELFTEST\]' $(SELFTEST_SIM)/sb_selftest.log | sed 's/^.*\[SB_SELFTEST\] //'; \
	 if [ "$$n" = "0" ] && [ "$$f" = "0" ]; then \
	    echo "SB_SELFTEST: PASS"; \
	 else \
	    echo "SB_SELFTEST: FAIL (UVM_ERROR=$$n UVM_FATAL=$$f)"; exit 1; \
	 fi

clean_sb_selftest:
	rm -rf $(SELFTEST_SIM) csrc_sb_selftest
